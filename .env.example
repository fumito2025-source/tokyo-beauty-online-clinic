# ========================================
# 東京美容オンラインクリニック EC サイト
# 環境変数設定ファイル
# ========================================
# このファイルを .env.local にコピーして各値を設定してください
# cp .env.example .env.local

# --- Supabase ---
# https://supabase.com でプロジェクトを作成してください
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# https://dashboard.stripe.com でAPIキーを取得してください
# テスト用: sk_test_... / 本番用: sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- アプリ設定 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- メール (任意: 処方薬注文後の通知用) ---
# SendGrid / Resend などを使う場合
# RESEND_API_KEY=re_your-key
# NOTIFICATION_EMAIL=clinic@example.com
